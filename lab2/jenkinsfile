pipeline {
    agent any

    environment {
        IMAGE_NAME     = "go-api"
        CONTAINER_NAME = "go-api-container"
        SONAR_PROJECT_KEY = "go-api-lab2"
        SONAR_TOKEN = credentials('sonarqube-creds')
        SONAR_HOST_URL = "http://host.docker.internal:9000"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/dramax8569/CI-CD-groovy-golang-docker.git'
            }
        }

        stage('Build (in Docker)') {
            steps {
                dir('lab2') {
                    sh """
                        echo "Verificando si Docker está disponible:"
                        docker --version
                        echo "Verificando contenido actual:"
                        ls -la
                        echo "Intentando con montaje relativo:"
                        docker run --rm -v "\$(pwd)":/app -w /app golang:1.22 ls -la
                    """
                }
            }
        }


        stage('Docker Build') {
            steps {
                dir('lab2') {
                    sh 'docker build -t $IMAGE_NAME .'
                }
            }
        }

        stage('Docker Run') {
            steps {
                sh '''
                    # Parar y eliminar contenedor existente si existe
                    docker stop go-api-container || true
                    docker rm go-api-container || true
                    
                    # Ejecutar nuevo contenedor en puerto disponible
                    docker run -d --name go-api-container -p 9090:8080 go-api:latest
                    
                    # Verificar que el contenedor esté corriendo
                    docker ps | grep go-api-container
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "=== HEALTH CHECK (inside container) ==="

                    echo "1. Waiting for app to start..."
                    sleep 5

                    echo "2. Checking logs:"
                    docker logs go-api-container

                    echo "3. Testing /ping endpoint from inside container..."
                    for i in {1..5}; do
                        docker exec go-api-container curl -f http://localhost:8080/ping && echo "✅ Success" && exit 0
                        echo "Retrying in 3s..."
                        sleep 3
                    done

                    echo "❌ Final attempt failed"
                    exit 1
                '''
            }
        }

        stage('Run Unit Tests and Coverage') {
            steps {
                dir('lab2') {
                    sh 'go test ./... -coverprofile=coverage.out'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('lab2') {
                    sh '''
                        docker run --rm \
                            -e SONAR_HOST_URL=$SONAR_HOST_URL \
                            -e SONAR_TOKEN=$SONAR_TOKEN \
                            -v $(pwd):/usr/src \
                            sonarsource/sonar-scanner-cli \
                            -Dsonar.projectKey=$SONAR_PROJECT_KEY \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=$SONAR_HOST_URL \
                            -Dsonar.login=$SONAR_TOKEN \
                            -Dsonar.go.coverage.reportPaths=coverage.out
                    '''
                }
            }
        }


    }

    post {
        always  { echo 'Pipeline completado' }
        failure { echo 'Fallo detectado. Revisa logs.' }
    }
}
