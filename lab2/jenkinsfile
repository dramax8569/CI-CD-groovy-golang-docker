pipeline {
    agent any

    environment {
        IMAGE_NAME     = "go-api"
        CONTAINER_NAME = "go-api-container"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/dramax8569/CI-CD-groovy-golang-docker.git'
            }
        }

        stage('Build (in Docker)') {
            steps {
                dir('lab2') {
                    sh """
                        echo "Verificando si Docker está disponible:"
                        docker --version
                        echo "Verificando contenido actual:"
                        ls -la
                        echo "Intentando con montaje relativo:"
                        docker run --rm -v "\$(pwd)":/app -w /app golang:1.22 ls -la
                    """
                }
            }
        }


        stage('Docker Build') {
            steps {
                dir('lab2') {
                    sh 'docker build -t $IMAGE_NAME .'
                }
            }
        }

        stage('Docker Run') {
            steps {
                sh '''
                    # Parar y eliminar contenedor existente si existe
                    docker stop go-api-container || true
                    docker rm go-api-container || true
                    
                    # Ejecutar nuevo contenedor en puerto disponible
                    docker run -d --name go-api-container -p 9090:8080 go-api:latest
                    
                    # Verificar que el contenedor esté corriendo
                    docker ps | grep go-api-container
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                echo "=== SIMPLIFIED HEALTH CHECK ==="
                
                echo "1. Waiting for application to start..."
                sleep 10
                
                echo "2. Checking container status:"
                docker ps | grep go-api-container
                
                echo "3. Checking application logs:"
                docker logs go-api-container
                
                echo "4. Testing application endpoints:"
                
                # Check if port is bound on host
                echo "Checking if port 9090 is bound:"
                netstat -tlnp | grep 9090 || echo "Port 9090 not found in netstat"
                
                # Test ping endpoint with verbose output  
                echo "Testing ping endpoint (/ping) with verbose output:"
                curl -v --connect-timeout 10 http://localhost:9090/ping || echo "❌ Ping endpoint failed with curl error code: $?"
                
                echo "5. Final health check for /ping endpoint:"
                # Your Go app has a /ping endpoint that returns "pong"
                curl -f http://localhost:9090/ping
                '''
            }
        }


    }

    post {
        always  { echo 'Pipeline completado' }
        failure { echo 'Fallo detectado. Revisa logs.' }
    }
}
